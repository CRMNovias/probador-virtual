# URL de la API del CRM (sin barra final).
# - CRM local de Herd (catálogo, citas y registro reales, como la V1): arranca con `npm run dev:crm`.
CRM_API_URL=https://crmnovias-com.test/api
# - CRM simulado de mock-crm/ (sin Herd): `npm run mock` y `npm run dev`.
# CRM_API_URL=http://localhost:4010/api

# Gemini, para el giro 360 mientras el CRM no lo tenga (docs/crm-360.md) y para la IA del simulador.
GEMINI_API_KEY=

# Subruta donde se sirve la app (sin barra final). En producción: /v2. En local, vacío.
# Se lee al compilar: si cambia, hay que volver a compilar.
# NEXT_PUBLIC_BASE_PATH=/v2
